---
# ansible-lint configuration.
#
# Nothing is skipped globally. Legitimate exceptions — Git CLI operations,
# the cross-directory template render, and the final run-once compliance
# aggregation — are silenced inline, so the rules stay live everywhere else.

exclude_paths:
  # Device output, not source. Committed on purpose as backup history.
  - backups/
  # Rendered template output. Gitignored; only present after a local run.
  - generated/
